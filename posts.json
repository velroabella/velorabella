"[\n  {\n    \"slug\": \"soft-glam-vs-full-glam-finding-your-perfect-bridal-look\",\n    \"title\": \"Soft Glam vs Full Glam: Finding Your Perfect Bridal Look\",\n    \"date\": \"February 11, 2025\",\n    \"category\": \"Bridal\",\n    \"excerpt\": \"Choosing between soft and full glam can feel overwhelming, but the right look is simply the one that makes you feel most like yourself.\",\n    \"content\": \"Soft glam embraces your natural features with luminous skin, subtle contouring, and a romantic flush, while full glam turns up the drama with bold lashes, defined brows, and a sculpted finish. Neither style is more bridal than the other — it all comes down to your personality, venue, and vision. At Velora Bella, we guide every bride through a personalized consultation to ensure her look feels intentional, polished, and completely her own.\",\n    \"image\": \"https://images.unsplash.com/photo-1662833834361-91c01779e985?ixid=M3w4ODY5OTB8MHwxfHNlYXJjaHwxfHxicmlkYWwlMjBtYWtldXAlMjB3ZWRkaW5nJTIwZmxvcmlkYXxlbnwwfHx8fDE3NzMwNzQzOTV8MA&ixlib=rb-4.1.0\"\n  },\n  {\n    \"slug\": \"test\",\n    \"title\": \"test\",\n    \"date\": \"test\",\n    \"category\": \"test\",\n    \"excerpt\": \"test\",\n    \"content\": \"test\",\n    \"image\": \"https://images.unsplash.com/photo-1662833834361-91c01779e985?ixid=M3w4ODY5OTB8MHwxfHNlYXJjaHwxfHxicmlkYWwlMjBtYWtldXAlMjB3ZWRkaW5nJTIwZmxvcmlkYXxlbnwwfHx8fDE3NzMwNzQzOTV8MA&ixlib=rb-4.1.0\"\n  }\n]"